# Copy to deploy/compose/.env (gitignored) before compose up.
SESSION_SECRET=change-me-session-secret-min-32-chars-long
PASSWORD_ENCRYPTION_KEY=change-me-password-key-different
COOKIE_SECURE=false
AUTH_CODE_KEY_MODE=hmac
AUTH_CODE_HMAC_KEY=change-me-hmac-key-at-least-32-bytes-long!!
METRICS_SECRET=change-me-metrics-secret
REDIS_APP_PASSWORD=change-me-redis-app-password-hex-only
