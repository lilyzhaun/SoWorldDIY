[Unit]
Description=3HK New dedicated Redis (loopback 6380)
After=network-online.target
Wants=network-online.target
Before=3hk-new.service

[Service]
RuntimeDirectory=3hk-new-redis
RuntimeDirectoryMode=0750
StateDirectory=3hk-new-redis
StateDirectoryMode=0750
Type=simple
User=redis
Group=redis
ExecStart=/usr/bin/redis-server /etc/3hk-new/redis/redis.conf
ExecStop=/bin/kill -s TERM $MAINPID
Restart=on-failure
RestartSec=3
LimitNOFILE=65535
# Hardening (adjust if redis user paths differ)
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes
ReadWritePaths=/var/lib/3hk-new-redis /run/3hk-new-redis /var/log/3hk-new-redis
CapabilityBoundingSet=
AmbientCapabilities=
LockPersonality=yes
MemoryDenyWriteExecute=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
SystemCallArchitectures=native

[Install]
WantedBy=multi-user.target
