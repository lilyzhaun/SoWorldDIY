SESSION_SECRET=change-me
PASSWORD_ENCRYPTION_KEY=change-me-different-long-random-string
REDIS_URL=redis://127.0.0.1:6379/0
# Dedicated instance target for migration CLI only (not read by the app runtime).
# REDIS_MIGRATE_DEST_URL=redis://127.0.0.1:6380/0
REDIS_SESSION_PREFIX=session:
PROXY_URL=
CMN_PROXY_URL=

COOKIE_SECURE=false

# Auth-code Redis key mode (migration-staged; default legacy preserves plaintext keys).
# legacy: read/write auth_code:<code>
# dual:   read legacy or auth_code:v2:<hmac>; write v2 only (requires AUTH_CODE_HMAC_KEY)
# hmac:   v2 only (requires AUTH_CODE_HMAC_KEY, refuses legacy keys)
AUTH_CODE_KEY_MODE=legacy
# Required when AUTH_CODE_KEY_MODE is dual or hmac. Min 32 random bytes. Never commit real values.
# AUTH_CODE_HMAC_KEY=

# Comma-separated proxies allowed to set X-Forwarded-For (default: loopback only).
# TRUSTED_PROXY_IPS=127.0.0.1,::1

# Optional rate-limit overrides (defaults match security plan).
# RATE_LIMIT_CHECK_USER_IP=30
# RATE_LIMIT_CHECK_USER_WINDOW=300
# RATE_LIMIT_SEND_OTP_ID=3
# RATE_LIMIT_SEND_OTP_ID_WINDOW=600
# RATE_LIMIT_SEND_OTP_IP=10
# RATE_LIMIT_SEND_OTP_IP_WINDOW=3600
# RATE_LIMIT_LOGIN_IP=10
# RATE_LIMIT_LOGIN_IP_WINDOW=900
# RATE_LIMIT_LOGIN_FAIL_ID=5
# RATE_LIMIT_LOGIN_FAIL_ID_WINDOW=900

# Required: secret for GET /metrics (header x-metrics-secret). Never commit real values.
METRICS_SECRET=change-me-metrics-secret
