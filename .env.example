SESSION_SECRET=change-me
PASSWORD_ENCRYPTION_KEY=change-me-different-long-random-string
REDIS_URL=redis://127.0.0.1:6379/0
# Dedicated instance target for migration CLI only (not read by the app runtime).
# REDIS_MIGRATE_DEST_URL=redis://127.0.0.1:6380/0
REDIS_SESSION_PREFIX=session:
PROXY_URL=
CMN_PROXY_URL=
external_delivery_token=
external_delivery_target=

COOKIE_SECURE=false

# Auth-code Redis key mode (migration-staged; default legacy preserves plaintext keys).
# legacy: read/write auth_code:<code>
# dual:   read legacy or auth_code:v2:<hmac>; write v2 only (requires AUTH_CODE_HMAC_KEY)
# hmac:   v2 only (requires AUTH_CODE_HMAC_KEY, refuses legacy keys)
AUTH_CODE_KEY_MODE=legacy
# Required when AUTH_CODE_KEY_MODE is dual or hmac. Min 32 random bytes. Never commit real values.
# AUTH_CODE_HMAC_KEY=
